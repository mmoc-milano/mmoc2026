---
const { title = "MMOC 2026" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <style>
      :root {
        --bg: #0f0f0f;
        --text: #ffffff;
        --orange: #c96a2b;
        --teal: #0f8b8d;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: Arial, sans-serif;
      }

      nav {
        width: 100%;
        padding: 24px 60px;
        display: flex;
        justify-content: center;
        gap: 50px;
        position: fixed;
        top: 0;
        background: rgba(15,15,15,0.9);
        backdrop-filter: blur(8px);
      }

      nav a {
        color: white;
        text-decoration: none;
        font-size: 18px;
        transition: 0.2s;
      }

      nav a:hover {
        color: var(--orange);
      }
    </style>
  </head>

  <body>

<nav>
  <a href={`${import.meta.env.BASE_URL}#description`}>Description</a>
  <a href={`${import.meta.env.BASE_URL}#participation`}>Participation</a>
  <a href={`${import.meta.env.BASE_URL}#schedule`}>Schedule</a>
  <a href={`${import.meta.env.BASE_URL}speakers`}>Speakers</a>
  <a href={`${import.meta.env.BASE_URL}#sponsors`}>Sponsors</a>
</nav>
	

    <slot />
  </body>
</html>
