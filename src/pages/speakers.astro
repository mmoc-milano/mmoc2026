---

<Layout title="Speakers - MMOC 2026">

  <main class="container">
    <h1>Speakers</h1>

     {speakers.map((s) => (
      <div class="speaker">
        <img src={s.img} alt={s.name} />

        <div class="info">
          <h3>{s.name}</h3>

      <p>
        <strong>Supervisor:</strong> {s.supervisor}
      </p>

      <p>
        <strong>Research Interests:</strong> {s.research}
      </p>

      <p>
        <strong>E-mail:</strong> {s.email}
      </p>
        </div>
      </div>
    ))}


  </main>

</Layout>

<style>
  .container {
    max-width: 1000px;
    margin: 120px auto;
    padding: 0 20px;
    color: white;
  }

  h1 {
    color: #c96a2b;
    margin-bottom: 40px;
  }

  .speaker {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
    align-items: center;
    padding: 20px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
  }

  .speaker img {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 12px;
  }

  .info h3 {
    margin: 0 0 10px;
    color: #0f8b8d;
  }

  .info p {
    margin: 0;
    color: #ccc;
  }
</style>