---
---

<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>MMOC 2026</title>

    <style>
      :root {
        --bg: #0f0f0f;
        --text: #ffffff;
        --orange: #c96a2b;
        --teal: #0f8b8d;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: Arial, sans-serif;
      }

      nav {
        width: 100%;
        padding: 24px 60px;
        display: flex;
        justify-content: center;
        gap: 50px;
        position: fixed;
        top: 0;
        background: rgba(15,15,15,0.9);
        backdrop-filter: blur(8px);
      }

      nav a {
        color: white;
        text-decoration: none;
        font-size: 18px;
        transition: 0.2s;
      }

      nav a:hover {
        color: var(--orange);
      }

      .hero {
        height: 100vh;

        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        text-align: center;
        padding: 20px;
      }

      .hero h1 {
        font-size: 90px;
        letter-spacing: 4px;
        margin-bottom: 20px;
      }

      .hero p {
        font-size: 24px;
        color: #cccccc;
        margin-bottom: 40px;
      }

      .hero button {
        background: var(--orange);
        color: white;
        border: none;
        padding: 16px 32px;
        border-radius: 12px;
        font-size: 18px;
        cursor: pointer;
        transition: 0.2s;
      }

      .hero button:hover {
        background: var(--teal);
      }

      section {
        max-width: 1000px;
        margin: auto;
        padding: 120px 20px;
      }

      h2 {
        font-size: 42px;
        margin-bottom: 30px;
        color: var(--orange);
      }

      p {
        line-height: 1.7;
        font-size: 18px;
      }
    </style>
  </head>

  <body>

    <nav>
      <a href="#description">Description</a>
      <a href="#participation">Participation</a>
      <a href="#sponsors">Sponsors</a>
    </nav>

    <div class="hero">
      <h1>MMOC 2026</h1>

      <p>
        Milano Molecular and Quantum Conference
      </p>

      <button>
        Participation
      </button>
    </div>

    <section id="description">
      <h2>Description</h2>

      <p>
        Insert conference description here.
      </p>
    </section>

    <section id="participation">
      <h2>Participation</h2>

      <p>
        Participation details.
      </p>
    </section>

    <section id="sponsors">
      <h2>Sponsors</h2>

      <p>
        Sponsors information.
      </p>
    </section>

  </body>
</html>
