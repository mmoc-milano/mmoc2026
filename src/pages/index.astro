---
---

<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>MMOC 2026</title>

    <style>
      :root {
        --bg: #0f0f0f;
        --text: #ffffff;
        --orange: #c96a2b;
        --teal: #0f8b8d;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: Arial, sans-serif;
      }

      nav {
        width: 100%;
        padding: 24px 60px;
        display: flex;
        justify-content: center;
        gap: 50px;
        position: fixed;
        top: 0;
        background: rgba(15,15,15,0.9);
        backdrop-filter: blur(8px);
      }

      nav a {
        color: white;
        text-decoration: none;
        font-size: 18px;
        transition: 0.2s;
      }

      nav a:hover {
        color: var(--orange);
      }

      .hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  text-align: center;
  padding: 20px;

  background:
    radial-gradient(circle at 30% 30%, rgba(15, 139, 141, 0.25), transparent 35%),
    radial-gradient(circle at 70% 60%, rgba(201, 106, 43, 0.22), transparent 35%);
}

      .hero h1 {
  font-size: clamp(64px, 10vw, 130px);
  letter-spacing: 8px;
  margin-bottom: 24px;
  line-height: 1;
}
      .hero p {
  font-size: 26px;
  color: #d0d0d0;
  margin-bottom: 48px;
}

<p class="event-info">
  Milan, Italy · 2026
</p>

.event-info {
  color: var(--teal);
  font-size: 18px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.hero button {
  background: linear-gradient(135deg, var(--orange), #9f4f1f);
  color: white;
  border: 1px solid rgba(255,255,255,0.15);
  padding: 16px 36px;
  border-radius: 999px;
  font-size: 18px;
  cursor: pointer;
}

      .hero button:hover {
        background: var(--teal);
      }

      section {
        max-width: 1000px;
        margin: auto;
        padding: 120px 20px;
      }

      h2 {
        font-size: 42px;
        margin-bottom: 30px;
        color: var(--orange);
      }

      p {
        line-height: 1.7;
        font-size: 18px;
      }
    </style>
  </head>

  <body>

    <nav>
      <a href="#description">Description</a>
      <a href="#participation">Participation</a>
      <a href="#sponsors">Sponsors</a>
    </nav>

    <div class="hero">
      <h1>MMOC 2026</h1>

      <p>
        Meet Me On Chem
      </p>

      <button>
        Participation
      </button>
    </div>

    <section id="description">
      <h2>Description</h2>

      <p>
        Insert conference description here.
      </p>
    </section>

    <section id="participation">
      <h2>Participation</h2>

      <p>
        Participation details.
      </p>
    </section>

    <section id="sponsors">
      <h2>Sponsors</h2>

      <p>
        Sponsors information.
      </p>
    </section>

  </body>
</html>
