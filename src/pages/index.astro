---
const keynoteSpeaker = {
  name: "Gilberto Corbellini",
  affiliation: "Full Professor - Sapienza University of Rome",
  bio: "Professor Gilberto Corbellini is an historian, essayist, and epistemologist; his academic interests lie in the history and philosophy of medicine, bioethics, and naturalistic political philosophy.",
  photo: "images/gilberto-corbellini.png",
};

const speakers = [
  {
    name: "Annalisa Polo",
    affiliation: "RSE - Researcher",
    bio: "After obtaining her PhD in Chemistry at University of Milan, Annalisa moved to industry research and joined the RSE group, focused on electrocatalysis and sustainability.",
    photo: "images/annalisa-polo.jpeg",
  },
  {
    name: "Andrea Bonetti",
    affiliation: "Indena - Researcher",
    bio: "After obtaining his PhD in Chemistry at University of Milan, Andrea has joined the Indena group more than ten years ago, one of the major italian industries focused on pharmaceutical manufacturing.",
    photo: "images/andrea-bonetti.jpeg",
  },
  {
    name: "Paolo Pollesel",
    affiliation: "ENI - Vice President at Eni",
    bio: "After obtaining his Master's Degree in Industrial Chemistry at University of Milan, Paolo has joined the R&D ENI group - now Renewable Energy & Environmental R&D - more than thirteen years ago.",
    photo: "images/paolo-pollesel.jpeg",
  },
];
---

<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>MMOC 2026</title>

    <style>
      :root {
        --bg: #0f0f0f;
        --text: #ffffff;
        --orange: #c96a2b;
        --teal: #0f8b8d;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: Arial, sans-serif;
      }

      nav {
        width: 100%;
        padding: 24px 60px;
        display: flex;
        justify-content: center;
        gap: 50px;
        position: fixed;
        top: 0;
        background: rgba(15,15,15,0.9);
        backdrop-filter: blur(8px);
      }

      nav a {
        color: white;
        text-decoration: none;
        font-size: 18px;
        transition: 0.2s;
      }

      nav a:hover {
        color: var(--orange);
      }

      .hero {
        min-height: 100vh;

        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        text-align: center;
        padding: 20px;

        background:
          radial-gradient(circle at 30% 30%, rgba(15, 139, 141, 0.25), transparent 35%),
          radial-gradient(circle at 70% 60%, rgba(201, 106, 43, 0.22), transparent 35%);
      }

      .hero h1 {
        font-size: clamp(64px, 10vw, 130px);
        letter-spacing: 8px;
        margin-bottom: 20px;
        line-height: 1;
      }

      .subtitle {
        font-size: 38px;
        font-weight: 300;
        color: #dddddd;
        margin-bottom: 18px;
      }

      .event-info {
        color: #9a9a9a;
        font-size: 14px;
        letter-spacing: 1px;
        margin-bottom: 50px;
        font-weight: 300;
      }

     .participation-button {
  background: linear-gradient(135deg, var(--orange), #9f4f1f);
  color: white;
  border: 1px solid rgba(255,255,255,0.15);
  padding: 16px 36px;
  border-radius: 999px;
  font-size: 18px;
  cursor: pointer;
  transition: 0.2s;
  text-decoration: none;
}

      .participation-button:hover {
        background: var(--teal);
      }

      section {
        max-width: 1000px;
        margin: auto;
        padding: 120px 20px;
      }

      h2 {
        font-size: 42px;
        margin-bottom: 30px;
        color: var(--orange);
      }

      p {
        line-height: 1.7;
        font-size: 18px;
      }
/*
      .sponsor-logo {
  background-color: white;
  padding: 10px;      /* opzionale: crea “bordo” bianco attorno */
  box-sizing: border-box;
   max-width: 300px;
  width: 100%;
  height: auto;
  display: block;
  margin: 20px auto;

}
*/
/* GRIGLIA RESPONSIVE */
.sponsors {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 25px;
  align-items: center;
  justify-items: center;
  
  margin-top: 30px;
  margin-bottom: 100px;
  
}
  
  #sponsors p {
  margin-top: 30px;
  margin-bottom: 40px;
  color: #9a9a9a;
}

/* BOX LOGO */
.sponsor-item {
  background: white;
  width: 160px;
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 12px;
  padding: 12px;

  box-shadow: 0 4px 15px rgba(0,0,0,0.25);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

/* IMMAGINE UNIFORME */
.sponsor-item img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

/* HOVER ELEGANTE */
.sponsor-item:hover {
  transform: translateY(-6px) scale(1.03);
  box-shadow: 0 10px 25px rgba(0,0,0,0.35);
}
    </style>
  </head>

  <body>


    <nav>
  <a href={`${import.meta.env.BASE_URL}#description`}>Description</a>
  <a href={`${import.meta.env.BASE_URL}#participation`}>Participation</a>
  <a href={`${import.meta.env.BASE_URL}#schedule`}>Schedule</a>
  <a href={`${import.meta.env.BASE_URL}/speakers`}>Speakers</a>
  <a href={`${import.meta.env.BASE_URL}#sponsors`}>Sponsors</a>
</nav>

    <div class="hero">

      <h1>MMOC</h1>

      <div class="subtitle">
        Meet Me On Chem 2026
      </div>

      <p class="event-info">
        Milan, Italy · Università degli Studi di Milano
      </p>

      <a href="https://docs.google.com/forms/d/e/1FAIpQLSdC9YXfxBlA2FBPfk_IxB5r2f5Y5tVgUEUdhGPyRKeQSxqCHg/viewform?usp=header" target="_blank" class="participation-button">
  Participation
</a>

    </div>

    <section id="description">
      <h2>Description</h2>

      <p>
        Meet Me on Chem (MMOC) is an annual two-days conference where second-year Chemistry PhD students are brought together to share their work through oral presentations in a welcoming and engaging framework.
      </p>

      <p>
        The 2026 edition will take place on September, 23rd-24th at Università degli Studi di Milano. In addition to oral presentations by invited PhD students, the conference will offer the possibility to other PhD Students in both Chemistry and Industrial Chemistry to present their work in the form of poster presentations.
      </p>
    </section>

    <section id="participation">
      <h2>Participation</h2>

      <p style="text-align: center; font-weight: bold; margin-bottom: 40px;">
      Registration is closed.  
      </p>

    </section>

<section id="schedule">
  <h2>Schedule</h2>

  <div class="pdf-embed">
    <embed src="/mmoc2026/schedule.pdf" type="application/pdf" width="100%" height="800px" />
    <p class="pdf-fallback">
      Can't see the PDF?
      <a href="/mmoc2026/schedule.pdf" target="_blank" rel="noopener noreferrer">Open it in a new tab</a>.
    </p>
  </div>
</section>

<style>
  .pdf-embed {
    margin-top: 1rem;
  }

  .pdf-embed embed {
    border: 1px solid #ddd;
    border-radius: 8px;
  }

  .pdf-fallback {
    font-size: 0.9rem;
    color: #666;
    margin-top: 0.5rem;
  }

  @media (max-width: 600px) {
    .pdf-embed embed {
      height: 500px;
    }
  }
</style>


<section id="invited_speakers">
  <h2>Invited Speakers</h2>

  <p>
    We are proud to announce the following invited speakers for MMOC 2026:
  </p>

  <h3 class="day-label">Day 1 - 23rd of September</h3>
  <div class="speakers-grid">
    <img src={`${import.meta.env.BASE_URL}/${keynoteSpeaker.photo}`} alt={keynoteSpeaker.name} class="speaker-photo" />
    <div class="speaker-info">
      <h3>{keynoteSpeaker.name}</h3>
      <p class="speaker-affiliation">{keynoteSpeaker.affiliation}</p>
      <p class="speaker-bio">{keynoteSpeaker.bio}</p>
    </div>
  </div>

  <h3 class="day-label">Day 2 - 24th of September</h3>
  <div class="speakers-grid">
    {speakers.map((speaker) => (
      <>
        <img src={`${import.meta.env.BASE_URL}/${speaker.photo}`} alt={speaker.name} class="speaker-photo" />
        <div class="speaker-info">
          <h3>{speaker.name}</h3>
          <p class="speaker-affiliation">{speaker.affiliation}</p>
          <p class="speaker-bio">{speaker.bio}</p>
        </div>
      </>
    ))}
  </div>
</section>

<style>
  .day-label {
    margin-top: 4rem; /* <-- qui, aumenta questo valore */
    margin-bottom: 0.5rem;
  }
  .speakers-grid {
    display: grid;
    grid-template-columns: auto 1fr; /* colonna 1: foto, colonna 2: testo */
    column-gap: 2rem;
    row-gap: 3rem;
    margin-top: 1.5rem;
    align-items: start;
  }

  .speaker-photo {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 50%;
  }

  .speaker-info h3 {
    margin: 0 0 0.25rem 0;
  }

  .speaker-affiliation {
    font-style: italic;
    color: #666;
    margin: 0 0 0.5rem 0;
    font-size: 0.9rem;
  }

  .speaker-bio {
    margin: 0;
    line-height: 1.5;
    font-size: 0.95rem;
  }

  @media (max-width: 600px) {
    .speakers-grid {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }
</style>

    <section id="sponsors">
      <h2>Sponsors</h2>

<div class="sponsors">
  <div class="sponsor-item">
    <img src="/mmoc2026/images/ZENTEK_SCI.png" alt="Sponsor 1">
  </div>

  <!--
  <div class="sponsor-item">
    <img src="images/logo2.png" alt="Sponsor 2">
  </div>
  -->
</div>

<p>
  More sponsors coming soon.
</p>
</section>
  </body>
</html>
